msgstr ""
"Begrenzen Sie Originalbreite und -höhe, damit riesige Handyfotos nie in "
"voller Größe auf Ihrem Server landen."

#: ../inc/settings.php:729
msgid "CDN URL mapping"
msgstr "CDN-URL-Zuordnung"

